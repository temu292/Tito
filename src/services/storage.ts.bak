import {
  BOOST_PLANS,
  CATEGORIES,
  INITIAL_SERVICES,
  INITIAL_USERS
} from '../data/initialData';
import {
  BoostPlan,
  Category,
  ChatMessage,
  PaymentTransaction,
  ReportItem,
  ServiceListing,
  User
} from '../types';
import {
  isSupabaseConfigured,
  supabase,
  mapRowToService,
  mapServiceToRow,
  ServiceRow
} from './supabase';

const SERVICES_KEY = 'vecinoya_services_v2';
const FAVORITES_KEY = 'vecinoya_favorites_v2';
const TRANSACTIONS_KEY = 'vecinoya_transactions_v2';
const REPORTS_KEY = 'vecinoya_reports_v2';
const CURRENT_USER_KEY = 'vecinoya_current_user_v2';
const CHAT_KEY = 'vecinoya_chats_v2';

// Helper to check and expire featured status
export function checkExpiration(services: ServiceListing[]): ServiceListing[] {
  const now = new Date();
  let changed = false;

  const updated = services.map(service => {
    if (service.isFeatured && service.featuredUntil) {
      const expiry = new Date(service.featuredUntil);
      if (expiry <= now) {
        changed = true;
        return {
          ...service,
          isFeatured: false,
          featuredPlanId: undefined,
          featuredPlanName: undefined
        };
      }
    }
    return service;
  });

  if (changed) {
    try {
      localStorage.setItem(SERVICES_KEY, JSON.stringify(updated));
    } catch {
      // ignore
    }
  }

  return updated;
}

// Synchronous local storage read (instant for SSR/initial render & offline cache)
export function getServices(): ServiceListing[] {
  try {
    const raw = localStorage.getItem(SERVICES_KEY);
    if (!raw) {
      localStorage.setItem(SERVICES_KEY, JSON.stringify(INITIAL_SERVICES));
      return checkExpiration(INITIAL_SERVICES);
    }
    const parsed = JSON.parse(raw) as ServiceListing[];
    return checkExpiration(parsed);
  } catch (err) {
    console.error('Error reading services from localStorage:', err);
    return INITIAL_SERVICES;
  }
}

// Synchronous local storage save
export function saveServices(services: ServiceListing[]): void {
  try {
    localStorage.setItem(SERVICES_KEY, JSON.stringify(services));
  } catch (err) {
    console.error('Error saving services to localStorage:', err);
  }
}

/**
 * Asynchronously fetch services from Supabase.
 * If Supabase is configured and reachable, fetches shared services.
 * Updates local cache and applies expiration checks.
 */
export async function fetchServicesFromRemote(): Promise<ServiceListing[]> {
  if (!isSupabaseConfigured || !supabase) {
    return getServices();
  }

  try {
    const { data, error } = await supabase
      .from('services')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      console.warn('Supabase fetch returned error, falling back to local cache:', error.message);
      return getServices();
    }

    if (data && data.length > 0) {
      const mapped = data.map((row: ServiceRow) => mapRowToService(row));
      const withExpirationChecked = checkExpiration(mapped);
      saveServices(withExpirationChecked);
      return withExpirationChecked;
    }

    // If Supabase table is empty on first setup, seed initial services so other devices see data
    try {
      const rowsToSeed = INITIAL_SERVICES.map(mapServiceToRow);
      await supabase.from('services').insert(rowsToSeed);
    } catch {
      // ignore seeding errors
    }

    return getServices();
  } catch (err) {
    console.warn('Network error while querying Supabase, using local fallback:', err);
    return getServices();
  }
}

/**
 * Publish a new service to Supabase and local cache.
 */
export async function createServiceRemote(service: ServiceListing): Promise<ServiceListing> {
  // Update local cache immediately
  const localList = getServices();
  const updatedLocal = [service, ...localList.filter(s => s.id !== service.id)];
  saveServices(updatedLocal);

  if (isSupabaseConfigured && supabase) {
    try {
      const row = mapServiceToRow(service);
      const { error } = await supabase.from('services').insert([row]);
      if (error) {
        console.error('Error inserting service into Supabase:', error.message);
      }
    } catch (err) {
      console.error('Network error posting service to Supabase:', err);
    }
  }

  return service;
}

/**
 * Update an existing service in Supabase and local cache.
 */
export async function updateServiceRemote(service: ServiceListing): Promise<ServiceListing> {
  const localList = getServices();
  const updatedLocal = localList.map(s => s.id === service.id ? service : s);
  saveServices(updatedLocal);

  if (isSupabaseConfigured && supabase) {
    try {
      const row = mapServiceToRow(service);
      const { error } = await supabase
        .from('services')
        .update(row)
        .eq('id', service.id);
      if (error) {
        console.error('Error updating service in Supabase:', error.message);
      }
    } catch (err) {
      console.error('Network error updating service in Supabase:', err);
    }
  }

  return service;
}

/**
 * Delete a service from Supabase and local cache.
 */
export async function deleteServiceRemote(serviceId: string): Promise<void> {
  const localList = getServices();
  const updatedLocal = localList.filter(s => s.id !== serviceId);
  saveServices(updatedLocal);

  if (isSupabaseConfigured && supabase) {
    try {
      const { error } = await supabase
        .from('services')
        .delete()
        .eq('id', serviceId);
      if (error) {
        console.error('Error deleting service from Supabase:', error.message);
      }
    } catch (err) {
      console.error('Network error deleting service from Supabase:', err);
    }
  }
}

/**
 * Subscribe to real-time changes on the Supabase 'services' table.
 * Returns an unsubscribe cleanup function.
 */
export function subscribeToServicesRealtime(
  onDataChange: () => void
): () => void {
  if (!isSupabaseConfigured || !supabase) {
    return () => {};
  }

  const channel = supabase
    .channel('realtime:services')
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'services' },
      () => {
        onDataChange();
      }
    )
    .subscribe();

  const client = supabase;
  return () => {
    client.removeChannel(channel);
  };
}

export function getCategories(): Category[] {
  return CATEGORIES;
}

export function getBoostPlans(): BoostPlan[] {
  return BOOST_PLANS;
}

export function getUsers(): User[] {
  return INITIAL_USERS;
}

export function getCurrentUser(): User {
  try {
    const raw = localStorage.getItem(CURRENT_USER_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      const found = INITIAL_USERS.find(u => u.id === parsed.id);
      if (found) return found;
    }
  } catch {
    // ignore
  }
  return INITIAL_USERS[0];
}

export function setCurrentUser(user: User): void {
  try {
    localStorage.setItem(CURRENT_USER_KEY, JSON.stringify(user));
  } catch {
    // ignore
  }
}

export function getFavorites(): string[] {
  try {
    const raw = localStorage.getItem(FAVORITES_KEY);
    if (!raw) return [];
    return JSON.parse(raw) as string[];
  } catch {
    return [];
  }
}

export function toggleFavorite(serviceId: string): string[] {
  const current = getFavorites();
  const exists = current.includes(serviceId);
  const updated = exists ? current.filter(id => id !== serviceId) : [...current, serviceId];
  try {
    localStorage.setItem(FAVORITES_KEY, JSON.stringify(updated));
  } catch {
    // ignore
  }
  return updated;
}

export function getTransactions(): PaymentTransaction[] {
  try {
    const raw = localStorage.getItem(TRANSACTIONS_KEY);
    if (!raw) {
      const initialTx: PaymentTransaction[] = [
        {
          id: 'tx_seed_1',
          serviceId: 'srv_1',
          serviceTitle: 'Paseo responsable y cuidado cariñoso de perros',
          userId: 'user_elena',
          userName: 'Elena Gómez',
          planId: 'premium',
          planName: 'Plan Premium',
          amount: 8.00,
          currency: 'EUR',
          status: 'completed',
          createdAt: new Date(Date.now() - 5 * 86400000).toISOString(),
          expiresAt: new Date(Date.now() + 25 * 86400000).toISOString(),
          referenceCode: 'VY-PREM-89104',
          provider: 'simulated_secure'
        },
        {
          id: 'tx_seed_2',
          serviceId: 'srv_2',
          serviceTitle: 'Pequeñas reparaciones del hogar, fontanería y bricolaje',
          userId: 'user_carlos',
          userName: 'Carlos Romero',
          planId: 'avanzado',
          planName: 'Plan Avanzado',
          amount: 5.00,
          currency: 'EUR',
          status: 'completed',
